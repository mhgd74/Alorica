# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS Configuration
# Comma-separated list of allowed origins for API access
# Example: https://aloricav1.vercel.app,http://localhost:3000,http://localhost:3080
ALLOWED_ORIGINS=https://aloricav1.vercel.app,http://localhost:3000,http://localhost:3080
